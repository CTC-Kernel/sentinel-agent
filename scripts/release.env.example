# Copy to scripts/.env.release (not committed) and fill in.

# Compiled into the agent: the API it talks to and where it looks for updates.
SENTINEL_SERVER_URL=https://grc.example.com/fn/agentApi
SENTINEL_RELEASES_BASE_URL=https://grc.example.com/releases/installer/agent
# Ed25519 public key the agent checks update packages against (docs/UPDATE_SIGNING.md).
# Empty: SHA-256 integrity only.
SENTINEL_UPDATE_PUBKEY=
export SENTINEL_SERVER_URL SENTINEL_RELEASES_BASE_URL SENTINEL_UPDATE_PUBKEY

# The server the packages are published on.
RELEASE_PUBLIC_URL=https://grc.example.com
RELEASE_SSH_HOST=deploy@grc.example.com
RELEASE_SSH_KEY=~/.ssh/id_release
# RELEASE_PUBLIC_DIR=/opt/sentinel/public-releases
# RELEASE_API_CONTAINER=sentinel-api

# macOS: notarytool keychain profile (xcrun notarytool store-credentials).
NOTARIZATION_KEYCHAIN_PROFILE=
export NOTARIZATION_KEYCHAIN_PROFILE
