#!/bin/sh
# Sentinel GRC Agent - Script post-installation
set -e

# Create dedicated service user/group
if ! getent group sentinel-grc > /dev/null 2>&1; then
    groupadd --system sentinel-grc
fi
if ! id -u sentinel-grc > /dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --gid sentinel-grc sentinel-grc
fi

# Create data directories
mkdir -p /var/lib/sentinel-grc
mkdir -p /var/lib/sentinel-grc/models
mkdir -p /var/lib/sentinel-grc/cache/llm
mkdir -p /var/log/sentinel-grc
mkdir -p /etc/sentinel

# Set ownership and permissions
chown sentinel-grc:sentinel-grc /var/lib/sentinel-grc
chown sentinel-grc:sentinel-grc /var/lib/sentinel-grc/models
chown sentinel-grc:sentinel-grc /var/lib/sentinel-grc/cache
chown sentinel-grc:sentinel-grc /var/lib/sentinel-grc/cache/llm
chown sentinel-grc:sentinel-grc /var/log/sentinel-grc
chown sentinel-grc:sentinel-grc /etc/sentinel
chmod 700 /var/lib/sentinel-grc
chmod 755 /var/lib/sentinel-grc/models
chmod 755 /var/lib/sentinel-grc/cache
chmod 755 /var/lib/sentinel-grc/cache/llm
chmod 755 /var/log/sentinel-grc
chmod 700 /etc/sentinel

# Copy config templates if config files don't exist yet
if [ ! -f /etc/sentinel/agent.json ] && [ -f /etc/sentinel/agent.example.json ]; then
    cp /etc/sentinel/agent.example.json /etc/sentinel/agent.json
    chown sentinel-grc:sentinel-grc /etc/sentinel/agent.json
    chmod 600 /etc/sentinel/agent.json
fi

if [ ! -f /etc/sentinel/llm.json ] && [ -f /etc/sentinel/llm.example.json ]; then
    cp /etc/sentinel/llm.example.json /etc/sentinel/llm.json
    chown sentinel-grc:sentinel-grc /etc/sentinel/llm.json
    chmod 600 /etc/sentinel/llm.json
fi

# Standalone installation: SENTINEL_STANDALONE=1 dpkg -i sentinel-agent_*.deb
# The agent protects this host locally (EDR, FIM, compliance, vulnerability
# scans) and never contacts a platform. `sentinel-agent standalone --disable`
# or an enrolment from the GUI reconnects it later.
case "${SENTINEL_STANDALONE:-0}" in
    1|true|yes)
        if [ ! -f /etc/sentinel/agent.json ]; then
            printf '{\n  "standalone": true,\n  "log_level": "info"\n}\n' > /etc/sentinel/agent.json
        elif grep -q '"standalone"' /etc/sentinel/agent.json; then
            sed -i 's/"standalone"[[:space:]]*:[[:space:]]*false/"standalone": true/' /etc/sentinel/agent.json
        else
            sed -i '0,/{/s/{/{\n  "standalone": true,/' /etc/sentinel/agent.json
        fi
        echo "Mode autonome : protection locale, aucune communication avec une plateforme."
        ;;
esac

# Set config file permissions if already exists
if [ -f /etc/sentinel/agent.json ]; then
    chown sentinel-grc:sentinel-grc /etc/sentinel/agent.json
    chmod 600 /etc/sentinel/agent.json
fi

# Activate AppArmor profile if available
if command -v apparmor_parser > /dev/null 2>&1; then
    if [ -f /etc/apparmor.d/usr.bin.sentinel-agent ]; then
        apparmor_parser -r /etc/apparmor.d/usr.bin.sentinel-agent || true
    fi
fi

# Reload systemd and enable service
systemctl daemon-reload
systemctl enable sentinel-agent.service

# Start or restart depending on install type
case "$1" in
    configure)
        if [ -z "$2" ]; then
            # Fresh install
            systemctl start sentinel-agent.service || true
        else
            # Upgrade
            systemctl restart sentinel-agent.service || true
        fi
        ;;
esac

echo "Sentinel GRC Agent installe avec succes."
echo "Service : systemctl status sentinel-agent"
echo "Config  : /etc/sentinel/agent.json"
echo "Mode    : 'sentinel-agent standalone' (protection locale) / 'sentinel-agent enroll' (plateforme)"
echo "LLM     : /etc/sentinel/llm.json"
echo "Models  : /var/lib/sentinel-grc/models/"
echo "Logs    : /var/log/sentinel-grc/"

#DEBHELPER#

exit 0
