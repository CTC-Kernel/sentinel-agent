#!/bin/sh
# Sentinel GRC Agent - Pre-removal script
set -e

case "$1" in
    remove|upgrade|deconfigure|0)
        # Stop the service before removal (rpm: 0 removal)
        if systemctl is-active --quiet sentinel-agent.service; then
            echo "Stopping Sentinel GRC Agent service..."
            systemctl stop sentinel-agent.service || true
        fi
        systemctl stop sentinel-agent-helper.service 2>/dev/null || true
        case "$1" in
            remove|0)
                systemctl disable sentinel-agent.service 2>/dev/null || true
                systemctl disable sentinel-agent-helper.service 2>/dev/null || true
                ;;
        esac
        ;;
    1)
        # rpm upgrade: rpm runs this, the old package's %preun, after the
        # new package's %post has restarted the service on the new files.
        # Stopping here would leave the agent stopped after the upgrade.
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
