#!/bin/sh
# Sentinel GRC Agent - Pre-removal script
set -e

case "$1" in
    remove|upgrade|deconfigure|0|1)
        # Stop the service before removal (rpm: 0 removal, 1 upgrade)
        if systemctl is-active --quiet sentinel-agent.service; then
            echo "Stopping Sentinel GRC Agent service..."
            systemctl stop sentinel-agent.service || true
        fi
        systemctl stop sentinel-agent-helper.service 2>/dev/null || true
        case "$1" in
            remove|0)
                systemctl disable sentinel-agent.service 2>/dev/null || true
                systemctl disable sentinel-agent-helper.service 2>/dev/null || true
                ;;
        esac
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
