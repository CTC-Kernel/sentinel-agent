# AppArmor profile for the Sentinel GRC agent
# Install: cp sentinel-agent /etc/apparmor.d/usr.bin.sentinel-agent
# Reload:  apparmor_parser -r /etc/apparmor.d/usr.bin.sentinel-agent
#
# STATUS: COMPLAIN MODE, NOT VALIDATED ON A REAL MACHINE.
# This profile was written from what the agent does (the files it reads, the
# tools its checks run, its sockets, the capabilities of its two systemd
# units). It has not been loaded on any distribution yet: its syntax was
# checked by hand against apparmor.d(5), not by apparmor_parser. It stays in
# complain mode (violations are logged, nothing is blocked) until it has run
# on each supported distribution and the denials it logs have been reviewed:
#   journalctl -k | grep 'apparmor="ALLOWED".*sentinel-agent'    (or aa-logprof)
# Only then remove `complain` from the flags below.
#
# Explicit `deny` rules are enforced even in complain mode: the few below are
# things the agent never needs. Do not add a deny for a path the agent reads
# (the previous profile denied /home, /root and /boot, which file integrity
# monitoring and the checks read).
#
# One binary, two services, one profile (attachment is by executable path):
#   sentinel-agent.service         user sentinel-grc, CAP_NET_RAW,
#                                  CAP_DAC_READ_SEARCH, CAP_KILL
#   sentinel-agent-helper.service  root, CAP_NET_ADMIN, CAP_NET_RAW, CAP_CHOWN,
#                                  CAP_FOWNER, CAP_DAC_OVERRIDE (firewall and
#                                  isolation actions asked over a socket)
# The capabilities below are the union; each unit keeps its own bounding set.
# No abi declaration and `#include` on purpose: the file must parse with
# AppArmor 2.13 (Ubuntu 20.04, Debian 10) as well as 3.x and 4.x.

#include <tunables/global>

/usr/bin/sentinel-agent flags=(complain,attach_disconnected) {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/ssl_certs>

    # ── Capabilities ────────────────────────────────────────────────────
    # Agent service: ICMP and ARP discovery, reading files whatever their
    # owner (integrity monitoring, compliance checks), stopping a malicious
    # process of another user.
    capability net_raw,
    capability dac_read_search,
    capability kill,
    # Helper service (root): iptables/nftables rules, ownership and mode of
    # its sockets and of the files it writes for the agent.
    capability net_admin,
    capability chown,
    capability fowner,
    capability dac_override,

    # ── Network ─────────────────────────────────────────────────────────
    # HTTPS to the platform, DNS, syslog forwarding, network discovery.
    network inet stream,
    network inet dgram,
    network inet6 stream,
    network inet6 dgram,
    network inet raw,
    network inet6 raw,
    network packet raw,
    network packet dgram,
    # Interfaces, routes, process events (proc connector), nftables.
    network netlink raw,
    network netlink dgram,
    # The helper sockets, the systemd notification socket, the Docker socket.
    network unix stream,
    network unix dgram,
    unix,

    # ── Other processes ─────────────────────────────────────────────────
    # Process inventory and telemetry read /proc/<pid>/{exe,cmdline,environ,
    # maps}; the helper reads /proc/<pid>/exe of the program that connects
    # to its socket to check it is the agent.
    ptrace (read),
    # Stopping a process (response action), and the signals systemd sends.
    signal (send) set=(term, kill),
    signal (receive),

    # ── The agent itself ────────────────────────────────────────────────
    # `ix`: the agent starts itself again for some sub-commands.
    /usr/bin/sentinel-agent mrix,

    # Configuration (agent.json, llm.json, CA certificate)
    /etc/sentinel/ r,
    /etc/sentinel/** rwk,

    # Data: SQLCipher database (locks, WAL), quarantine store, caches
    /var/lib/sentinel-grc/ rw,
    /var/lib/sentinel-grc/** rwk,

    # Logs
    /var/log/sentinel-grc/ rw,
    /var/log/sentinel-grc/** rw,
    /var/log/sentinel/ rw,
    /var/log/sentinel/** rw,

    # Helper sockets: created by the helper, connected to by the agent
    /{,var/}run/sentinel-agent.sock rw,
    /{,var/}run/sentinel-agent-service.sock rw,
    # Service readiness and watchdog
    /{,var/}run/systemd/notify w,
    # Container inventory
    /{,var/}run/docker.sock rw,
    /{,var/}run/podman/podman.sock rw,
    /{,var/}run/containerd/containerd.sock rw,
    /{,var/}run/crio/crio.sock rw,

    # Temporary files (the units run with PrivateTmp)
    /tmp/ r,
    owner /tmp/** rwk,
    /var/tmp/ r,
    owner /var/tmp/** rwk,

    # ── Reading the system ──────────────────────────────────────────────
    # A compliance and integrity agent reads everywhere: /etc (sshd, PAM,
    # sudoers, shadow for the password policy), /proc and /sys (kernel
    # settings, processes, USB and block devices), /var/log (log analysis),
    # /boot, /usr and /home (file integrity monitoring), package databases.
    # Reads are therefore not restricted by path; writes are, to the
    # directories above.
    / r,
    /** r,

    # USB mass-storage policy: de-authorization of storage interfaces and
    # the udev rule that does it at plug-in. Also needs the unit to allow it
    # (ProtectSystem, ProtectKernelTunables): until then the agent reports
    # "detection only".
    /sys/devices/**/authorized w,
    /etc/udev/rules.d/99-sentinel-usb-storage.rules rw,

    # ── Programs run by the checks and the response actions ─────────────
    # Shell and text tools run inside this profile (`ix`): they only read.
    /{,usr/}bin/{sh,dash,bash} ix,
    /{,usr/}bin/{cat,grep,egrep,fgrep,awk,gawk,mawk,sed,cut,sort,uniq,head,tail,wc,tr,ls,stat,find,xargs,id,uname,hostname,which,sleep,date,true,false,test,echo,printf,env,readlink,basename,dirname} ix,

    # System tools keep their own profile when they have one, and run
    # unconfined otherwise (`PUx`, with a scrubbed environment): they need
    # their own locks, sockets and privileges (dpkg and rpm databases,
    # systemd and D-Bus, xtables lock, container engines), which do not
    # belong in this profile.
    # Services, logs, time
    /{,usr/}{,s}bin/{systemctl,journalctl,timedatectl,chronyc,resolvectl,systemd-resolve,udevadm,loginctl} PUx,
    # Packages
    /{,usr/}{,s}bin/{apt,apt-get,apt-cache,dpkg,dpkg-query,rpm,dnf,yum,zypper,snap,flatpak} PUx,
    /usr/lib/update-notifier/apt-check PUx,
    # Network
    /{,usr/}{,s}bin/{ip,ss,netstat,arp,ifconfig,ping,host,nslookup,dig,iptables,ip6tables,iptables-save,ip6tables-save,nft,ufw,firewall-cmd} PUx,
    /{,usr/}{,s}bin/{xtables-legacy-multi,xtables-nft-multi} PUx,
    # Processes, kernel, devices
    /{,usr/}{,s}bin/{ps,pgrep,pidof,kill,lsof,lsmod,lsblk,lsusb,sysctl,getent,passwd,crontab,getenforce,sestatus,aa-status,apparmor_status} PUx,
    # Cryptography, directory, antivirus, backup, containers
    /{,usr/}{,s}bin/{openssl,gpg,trust,ldapsearch,clamscan,timeshift,docker,podman} PUx,
    /opt/sophos-av/bin/savdstatus PUx,
    /opt/eset/esets/sbin/esets_daemon PUx,
    # Desktop settings and dialogs (agent started in a user session)
    /{,usr/}bin/{gsettings,xfconf-query,zenity,kdialog,xdg-open,notify-send} PUx,

    # ── Never needed ────────────────────────────────────────────────────
    # Enforced even in complain mode, and logged.
    audit deny /dev/{mem,kmem,port} rwklx,
    audit deny @{PROC}/kcore rwklx,
    # The agent does not rewrite the policy that confines it.
    audit deny /etc/apparmor.d/** wl,
    audit deny /sys/kernel/security/apparmor/** w,
    # Nor the boot chain.
    audit deny /boot/** wl,
}
