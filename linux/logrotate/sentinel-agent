/var/log/sentinel-grc/*.log {
    # The directory belongs to the service user: rotate as that user.
    su sentinel-grc sentinel-grc
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    # The agent keeps agent.log open and has no reload: copy it, then
    # truncate it in place (it writes in append mode).
    copytruncate
}
